<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:rxui="http://reactiveui.net"
             xmlns:app="clr-namespace:SWSMonitor"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:SWSMonitor.ViewModels"
             x:DataType="vm:HomeViewModel"
             x:Class="SWSMonitor.HomeView">
    <Design.DataContext>
        <vm:HomeViewModel />
    </Design.DataContext>

    <Grid Name="OuterGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Popup  PlacementTarget="OuterBorder" Placement="Center" Width="900" Height="750" Topmost="True" VerticalOffset="80"
                    Name="ActionPopup"  IsOpen="{Binding IsActionPopupOpen}">
				    <Border Background="DarkGray" BorderBrush="{DynamicResource ResourceKey=PaneBackground}" BorderThickness="2" Padding="10" Margin="50,0,0,0">
					<StackPanel Margin="10,5,10,5" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="{Binding ActionMessageText}"/>
                        <StackPanel Orientation ="Horizontal" HorizontalAlignment="Center">
  					       <Button Content="Yes" Click="Action_Click" Margin="10,10,15,0"/>
						   <Button Content="No" Click="Cancel_Click" Margin="0,10,0,0"/>
                       </StackPanel>
                    </StackPanel>
				</Border>
    		</Popup>

        <ScrollViewer>
		<Border Name="OuterBorder" BorderBrush="Black" BorderThickness="2" MinWidth="900" MinHeight="770" HorizontalAlignment="Center">
			<StackPanel Spacing="5" VerticalAlignment="Top">
                 <StackPanel Height="50" Background="{DynamicResource ResourceKey=PaneBackground}">
					<Label Content="{Binding PageTitle}" FontSize="24" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <Label Content="{Binding SelectedSurveyInfo}" FontSize="16"  HorizontalAlignment="Center" VerticalAlignment="Top" />
                 </StackPanel>
                 <!-- Content area for navigated pages -->
                <ContentControl Content="{Binding CurrentWizardPage}">
                </ContentControl>
            </StackPanel>
            </Border>
            </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="15" HorizontalAlignment="Center" IsVisible="{Binding IsSurveyLoaded}">
            <Button TabIndex="1000" x:Name="GoBackButton" Content="{Binding GoBackButtonText}" IsVisible="{Binding CanGoBack}" Click="GoBackButton_Click" Margin="0,0,10,0"/>
            <SplitButton Content="{Binding GoNextButtonText}" IsVisible="{Binding IsSurveyLoaded}" Click="GoNextButton_Click" >
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Teams" Click="NavigateToTeams" />
                        <MenuItem Header="Conditions" Click="NavigateToConditions" />
                        <MenuItem Header="Beach Setting" Click="NavigateToBeachSetting" />
                        <MenuItem Header="Profiles" Click="NavigateToProfiles" />
                        <MenuItem Header="Quadrats" Click="NavigateToQuadrats" />
                        <MenuItem Header="Species List" Click="NavigateToSpeciesList" />
                        <MenuItem Header="Select Different Survey" Click="NavigateToSelectDifferentStudy" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <Button TabIndex="1012" x:Name="SaveButton" Content="Save" IsEnabled="{Binding CanEditSurvey}" IsVisible="{Binding IsDirty}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>