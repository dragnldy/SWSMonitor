<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SWSMonitor.GlossariesView"
             xmlns:vm="using:SWSMonitor.ViewModels"
			 xmlns:views="clr-namespace:SWSMonitor"
             x:CompileBindings="False"
             x:DataType="vm:GlossariesViewModel">
    <Design.DataContext>
        <vm:GlossariesViewModel/>
    </Design.DataContext>
    <Border BorderBrush="Black" BorderThickness="2">
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch">
           <StackPanel Height="50" Background="{DynamicResource ResourceKey=PaneBackground}" VerticalAlignment="Top">
			    <Label Content="{Binding PageTitle}" FontSize="24" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Top"/>
           </StackPanel>
           <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="5,0,5,0" IsVisible="{Binding UserIsAdmin}">
                    <Button Click="AddSpecies_Click" Tag="{Binding .}" ToolTip.Tip="Add Species">
                        <Image Source="avares://SWSMonitor/Assets/AddNew.png" 
                        Width="12" Height="12" Margin="0"/>
                    </Button>
                <CheckBox Content="Observed Only?" IsChecked="{Binding ActiveOnly}"/>
                </StackPanel>
           </StackPanel>
			<Popup Name="MyPopup"  IsOpen="{Binding IsPopupOpen}" PlacementTarget="DataGrid" Placement="Center">
				<Border Background="DarkGray" BorderBrush="{DynamicResource ResourceKey=PaneBackground}" BorderThickness="2" Padding="10">
					<StackPanel>
						<views:GlossaryView x:Name="NewGlossaryView" />
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button IsVisible="{Binding UserHasEditRole}" IsEnabled="{Binding CanSave}" Content="Save" Click="UpdateSpecies_Click" Margin="0,0,5,0"/>
							<Button Content="Cancel" Click="ClosePopup_Click"/>
						</StackPanel>
					</StackPanel>
				</Border>
		</Popup>
			<Popup Name="MyReadOnlyPopup"  IsOpen="{Binding IsReadOnlyPopupOpen}" PlacementTarget="DataGrid" Placement="Center">
				<Border Background="DarkGray" BorderBrush="{DynamicResource ResourceKey=PaneBackground}" BorderThickness="2" Padding="10">
					<StackPanel>
    						<views:GlossaryReadOnlyView x:Name="NewGlossaryReadOnlyView" />
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button IsVisible="{Binding UserHasEditRole}" IsEnabled="{Binding CanSave}" Content="Save" Click="UpdateSpecies_Click" Margin="0,0,5,0"/>
							<Button Content="Cancel" Click="ClosePopup_Click"/>
						</StackPanel>
					</StackPanel>
				</Border>
		</Popup>
        <Popup Name="ErrorPopup" IsOpen="{Binding PopupIsOpen}" PlacementTarget="DataGrid" Placement="Center">
				<Border Background="DarkGray" BorderBrush="{DynamicResource ResourceKey=PaneBackground}" BorderThickness="2" Padding="10">
					<StackPanel>
                        <Label Content="{Binding PopupMessage}"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Yes" Click="ConfirmDeleteButton_Click"> </Button>
							<Button Content="Cancel" Click="ClosePopup_Click"/>
						</StackPanel>
					</StackPanel>
				</Border>
		</Popup>

        <DataGrid Name="DataGrid" ItemsSource="{Binding Species}" x:Name="SpeciesDataGrid"
                               DoubleTapped="DataGrid_DoubleTapped" 
                               SelectedItem="{Binding SelectedSpecies}"
                                Height="650"
                                AutoGenerateColumns="False" IsReadOnly="True" 
                                CanUserReorderColumns="True"
                                CanUserResizeColumns="True"
                                CanUserSortColumns="True"
                                GridLinesVisibility="All" 
                                Margin="20" 
                                BorderThickness="1" 
                                BorderBrush="Gray">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" 
                                                    IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.UserHasEditRole}"
                                                    Margin="5,0,5,0">
                                        <Button Click="EditButton_Click" Tag="{Binding .}" ToolTip.Tip="Edit Species">
                                            <Image Source="avares://SWSMonitor/Assets/Data-Edit.png" 
									             Width="12" Height="12" Margin="0"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.UserHasViewOnlyRole}"
                                                    Margin="5,0,5,0">
                                        <Button Click="ViewButton_Click" Tag="{Binding .}" ToolTip.Tip="View Species">
                                            <Image Source="avares://SWSMonitor/Assets/People.png" 
									             Width="12" Height="12" Margin="0"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,0,5,0" IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.UserHasEditRole}">
                                        <Button Click="DeleteButton_Click" Tag="{Binding .}" ToolTip.Tip="Delete Species" >
                                            <Image Source="avares://SWSMonitor/Assets/TrashCan.png" 
									             Width="12" Height="12" Margin="0"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding ScientificName}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="5">
                                            <TextBlock Text="Scientific Name"/>
                                            <!-- Bind the TextBox Text property to a property in your ViewModel (e.g., ScientificNameFilterText) -->
                                            <TextBox Text="{Binding $parent[UserControl].DataContext.ScientificNameFilterText, Mode=TwoWay}"
                                                     PlaceholderText="Search..."/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding CommonNameOrDescription}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="5">
                                            <TextBlock Text="Common Name"/>
                                            <!-- Bind the TextBox Text property to a property in your ViewModel (e.g., CommonNameFilterText) -->
                                            <TextBox Text="{Binding $parent[UserControl].DataContext.CommonNameFilterText, Mode=TwoWay}"
                                                     PlaceholderText="Search..." />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TSN}">
                                 <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="5">
                                            <TextBlock Text="TSN"/>
                                            <!-- Bind the TextBox Text property to a property in your ViewModel (e.g., TSNFilterText) -->
                                            <TextBox Text="{Binding $parent[UserControl].DataContext.TsnFilterText, Mode=TwoWay}"
                                                     PlaceholderText="Search..."/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="AphiaID" Binding="{Binding AphiaID}"/>
                            <DataGridCheckBoxColumn Header="Used?" Binding="{Binding IsUsedBySurveys}"/>
                            <DataGridTextColumn Header="Taxonomy (G;F;O;C;SP;P;K)" Binding="{Binding FullTaxonomy}"/>
                        </DataGrid.Columns>
                    </DataGrid>
       </StackPanel>
   </Border>
</UserControl>
