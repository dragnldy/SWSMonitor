<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:SWSMonitor.ViewModels"
             xmlns:svg="using:Avalonia.Svg.Skia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SWSMonitor.SettingsView"
             x:DataType="viewmodels:SettingsViewModel">
    <Design.DataContext>
        <viewmodels:SettingsViewModel />
    </Design.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer>
		<Border BorderBrush="Black" BorderThickness="2" Width="800">
			<StackPanel Spacing="5" VerticalAlignment="Top">
                 <StackPanel Height="50" Background="{DynamicResource ResourceKey=PaneBackground}">
					<Label Content="Settings" FontSize="24" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                 </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10,20,0,0" Spacing="10" HorizontalAlignment="Center">

                    <!-- Settings form -->
                    <TextBlock Text="Settings" FontWeight="Bold" FontSize="18"/>
                    <CheckBox Content="Require Authentication?" IsChecked="{Binding RequireAuthentication, Mode=TwoWay}" VerticalAlignment="Center" />
                    <CheckBox Content="Require Audit Trail?" IsChecked="{Binding RequireAuditTrail, Mode=TwoWay}" VerticalAlignment="Center" />

                    <!-- Archival Actions -->
                     <StackPanel Orientation="Vertical" Margin="10,20,0,0" Spacing="10">
                        <TextBlock Text="Archive Requests" FontWeight="Bold" FontSize="18"/>
                        <CheckBox Content="Global Data" IsChecked="{Binding IncludeGlobalDataInArchive}" />
                        <CheckBox Content="Study Data" IsChecked="{Binding IncludeSurveyDataInArchive}" />
                        <Button Click="DoArchive" Margin="0,10,0,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Margin="0" HorizontalAlignment="Center" Spacing="10">
                                    <Image Source="avares://BeachSurvey/Assets/Upload - 01.png" 
									             Width="12" Height="12" Margin="0"/>
                                    <TextBlock Text="Export Archived Data to Cloud" VerticalAlignment="Center"/>
                                </StackPanel>

                            </Button.Content>
                        </Button>
                        <Button Click="DoImport" Margin="0,10,0,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Margin="0" HorizontalAlignment="Center" Spacing="10">
                                    <Image Source="avares://BeachSurvey/Assets/Download - 01.png" 
									             Width="12" Height="12" Margin="0"/>
                                    <TextBlock Text="Import Archived Data from Cloud" VerticalAlignment="Center"/>
                                </StackPanel>

                            </Button.Content>
                        </Button>
                        <Button Click="OpenUWExport_PopUp" Margin="0,10,0,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Margin="0" HorizontalAlignment="Center" Spacing="10">
                                    <Image Source="avares://BeachSurvey/Assets/CSV-Export.png" 
									             Width="12" Height="12" Margin="0"/>
                                    <TextBlock Text="Generate UW Quadrat CSV File" VerticalAlignment="Center"/>
                                </StackPanel>

                            </Button.Content>
                        </Button>
                        <Popup Name="MyPopup"  IsOpen="{Binding IsPopupOpen}" Placement="Center">
				            <Border Background="DarkGray" BorderBrush="{DynamicResource ResourceKey=PaneBackground}" BorderThickness="2" Padding="10">
					            <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Start Date:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <DatePicker SelectedDate="{Binding UWExportStartDate}" Grid.Row="0" Grid.Column="1"/>
                                        <TextBlock Text="End Date:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,5,0"/>
                                        <DatePicker SelectedDate="{Binding UWExportEndDate}" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"/>
                                        <CheckBox Content="Include Header Row?" IsChecked="{Binding UWExportIncludeHeader}" 
                                                  Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0"/>
                                    </Grid>
						            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							            <Button IsEnabled="{Binding CanSave}" Content="Save" Click="ExportToUW_Click" Margin="0,0,5,0"/>
							            <Button Content="Cancel" Click="ClosePopup_Click"/>
						            </StackPanel>
					            </StackPanel>
				            </Border>
    		            </Popup>

                            <!-- Progress bar and status message -->
                        <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                             <TextBlock Text="{Binding ArchiveStatusMessage}" FontStyle="Italic" Margin="0,5,0,0"/>
                            <ProgressBar Width="300" Height="20" Minimum="0" Maximum="100" IsVisible="{Binding ArchiveInProgress}"
                                         Value="{Binding ArchiveProgressValue}" />
                             <TextBlock Text="{Binding ArchiveProgressMessage}" Margin="0,10,0,0" Width="200" Height="300"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
             </StackPanel>
          </Border>
       </ScrollViewer>
    </Grid>
</UserControl>
