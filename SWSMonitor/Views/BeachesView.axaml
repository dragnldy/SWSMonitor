<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="450"
             x:Class="SWSMonitor.BeachesView" 
             xmlns:vm="using:SWSMonitor.ViewModels"
			 xmlns:views="clr-namespace:SWSMonitor"
             x:CompileBindings="False"
             x:DataType="vm:BeachesViewModel">
    <Design.DataContext>
        <vm:BeachesViewModel/>
    </Design.DataContext>
    <Border BorderBrush="Black" BorderThickness="2">
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch">
           <StackPanel Height="50" Background="{DynamicResource ResourceKey=PaneBackground}" VerticalAlignment="Top">
			    <Label Content="{Binding PageTitle}" FontSize="24" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Top"/>
           </StackPanel>
           <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="5,0,5,0" IsVisible="{Binding UserHasEditRole}">
                    <Button Click="AddBeach_Click" Tag="{Binding .}" ToolTip.Tip="Add Beach">
                        <Image Source="avares://SWSMonitor/Assets/AddNew.png" 
                        Width="12" Height="12" Margin="0"/>
                    </Button>
                </StackPanel>
              <CheckBox Content="Monitored Only?" IsChecked="{Binding ActiveOnly}"/>
           </StackPanel>
			<Popup Name="MyPopup"  IsOpen="{Binding IsPopupOpen}" PlacementTarget="DataGrid" Placement="Center">
				<Border Background="DarkGray" BorderBrush="{DynamicResource ResourceKey=PaneBackground}" BorderThickness="2" Padding="10">
					<StackPanel>
                        <views:BeachView/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button IsVisible="{Binding UserHasEditRole}" IsEnabled="{Binding CanSave}" Content="Save" Click="UpdateBeach_Click" Margin="0,0,5,0"/>
							<Button Content="Cancel" Click="ClosePopup_Click"/>
						</StackPanel>
					</StackPanel>
				</Border>
		</Popup>
        <Popup Name="ErrorPopup" IsOpen="{Binding PopupIsOpen}" PlacementTarget="DataGrid" Placement="Center">
				<Border Background="DarkGray" BorderBrush="{DynamicResource ResourceKey=PaneBackground}" BorderThickness="2" Padding="10">
					<StackPanel>
                        <Label Content="{Binding PopupMessage}"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Yes" Click="ConfirmDeleteButton_Click"> </Button>
							<Button Content="Cancel" Click="ClosePopup_Click"/>
						</StackPanel>
					</StackPanel>
				</Border>
		</Popup>

        <DataGrid Name="DataGrid" ItemsSource="{Binding Beaches}" x:Name="BeachesDataGrid"
                               DoubleTapped="DataGrid_DoubleTapped" 
                               SelectedItem="{Binding SelectedBeach}"
                                Height="650"
                                AutoGenerateColumns="False" IsReadOnly="True" 
                                CanUserReorderColumns="True"
                                CanUserResizeColumns="True"
                                CanUserSortColumns="True"
                                GridLinesVisibility="All" 
                                Margin="20" 
                                BorderThickness="1" 
                                BorderBrush="Gray">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" 
                                                    IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.UserHasEditRole}"
                                                    Margin="5,0,5,0">
                                        <Button Click="EditButton_Click" Tag="{Binding .}" ToolTip.Tip="Edit Beach">
                                            <Image Source="avares://SWSMonitor/Assets/Data-Edit.png" 
									             Width="12" Height="12" Margin="0"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.UserHasViewRole}"
                                                    Margin="5,0,5,0">
                                        <Button Click="ViewButton_Click" Tag="{Binding .}" ToolTip.Tip="View Beach">
                                            <Image Source="avares://SWSMonitor/Assets/Beach.png" 
									             Width="12" Height="12" Margin="0"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,0,5,0" IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.UserHasEditRole}">
                                        <Button Click="DeleteButton_Click" Tag="{Binding .}" ToolTip.Tip="Delete Beach" >
                                            <Image Source="avares://SWSMonitor/Assets/TrashCan.png" 
									             Width="12" Height="12" Margin="0"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Beach"  Binding="{Binding BeachName}"/>
                            <DataGridTextColumn Header="Island"  Binding="{Binding Island}"/>
                            <DataGridTextColumn Header="Latitude"  Binding="{Binding Lat}" MaxWidth="100"/>
                            <DataGridTextColumn Header="Longitude"  Binding="{Binding Long}" MaxWidth="120"/>
                            <DataGridTemplateColumn Header="Directions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding BeachDirections}" TextWrapping="Wrap" Width="400" MaxHeight="60"
                                                   ToolTip.Tip="{Binding BeachDirections}" />
                                    </StackPanel>
                                </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="Monitored?"  Binding="{Binding IsCurrentlyMonitored}"/>
                        </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
   </Border>
</UserControl>
