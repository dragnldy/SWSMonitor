<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SWSMonitor.ViewModels"
			 xmlns:local="using:SWSMonitor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SWSMonitor.SurveyView"
             x:CompileBindings="True"
             x:DataType="vm:SurveyViewModel">
	<Design.DataContext>
		<vm:SurveyViewModel />
	</Design.DataContext>
	<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
	    <Grid ColumnDefinitions="175,175" RowDefinitions="auto,auto,auto,auto,auto" Margin="10,10,0,0"  IsVisible="{Binding !IsSurveySelected}">
			<RadioButton Grid.Column="0" Grid.Row="0" Name="radioButton2" IsChecked="{Binding IsWhidbey}" GroupName="Island" Content="Whidbey Island" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
			<RadioButton Grid.Column="1" Grid.Row="0" Name="radioButton1" IsChecked="{Binding IsCamano}" GroupName="Island" Content="Camano Island" Margin="40,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
			<Label Grid.Column="0" Grid.Row="1" Content="Beach:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,3,0"/>
			<ComboBox Grid.Column="1" Grid.Row="1" ItemsSource="{Binding SurveySites}" SelectedItem="{Binding SelectedBeach}" Width="200" 
						MaxDropDownHeight="200" AutoScrollToSelectedItem="True"
						HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,0,0">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding BeachName}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<Label Grid.Column="0" Grid.Row="2" Content="Previous Surveys:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,3,0"/>
			<Border Grid.Column="1" Grid.Row="2" BorderThickness="2" BorderBrush="{DynamicResource ResourceKey=ListBoxBorder}" Width="200" Margin="12,5,0,5">
				<ListBox  SelectedItem="{Binding SelectedDate}"
					ItemsSource="{Binding SurveyDates}" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Top">
					 <ListBox.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Padding" Value="0"/>
							<Setter Property="Margin" Value="0"/>
							</Style>
						 </ListBox.Styles>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<TextBlock HorizontalAlignment="Center" Text="{Binding ., StringFormat='{}{0:MM/dd/yyyy}'}" FontSize="12"  />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>		
			</Border>
			<Label Content="Survey Date:" Grid.Column="0" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center"/>
			<CalendarDatePicker Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" SelectedDateFormat="Short"
								SelectedDate="{Binding SurveyDate}" Margin="0,0,3,0" Width="200"/>
			<!-- Action Buttons -->
			<StackPanel IsVisible="{Binding IsExistingSurvey}" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
				<Label Content="For existing survey, do you want to:" VerticalAlignment="Center"></Label>
				<Button IsEnabled="True" Content="View Survey" Click="ViewSurvey_Click" Margin="0,0,10,0"/>
	            <Button IsVisible="{Binding UserCanEdit}" Content="Edit Survey" Click="EditSurvey_Click" />
			</StackPanel>
			<StackPanel IsVisible="{Binding UserCanCreateStudy}" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
				<Label Content="For NEW survey, do you want to:" VerticalAlignment="Center"></Label>
				<Button IsEnabled="True" Content="Create Survey" Click="CreateSurvey_Click" Margin="0,0,10,0"/>
			</StackPanel>
			<StackPanel IsVisible="{Binding DoesSurveyNeedConfirmed}" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
				<Label Content="For NEW survey, do you want to continue:" VerticalAlignment="Center"></Label>
				<Button IsEnabled="True" Content="Create" Click="ConfirmNewSurvey_Click" Margin="0,0,10,0"/>
				<Button IsEnabled="True" Content="Cancel" Click="CancelNewSurvey_Click" Margin="0,0,10,0"/>
			</StackPanel>
		</Grid>

		<!-- Survey Details- Hidden until either existing survey is picked or new one is created -->
		<StackPanel IsVisible="{Binding IsSurveySelected}" Margin="0,60,0,0">
			<StackPanel IsVisible="{Binding IsSurveyLoading}" Margin="0,20,0,0">
				<Label Content="Survey loading..."/>
			</StackPanel>
			<StackPanel IsVisible="{Binding IsSurveyReady}" Margin="0,20,0,0">
				<Label Content="{Binding SurveyStatusInfo}"/>
			</StackPanel>

		</StackPanel>
	</StackPanel>
</UserControl>
