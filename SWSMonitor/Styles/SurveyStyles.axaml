<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20" >
        <StackPanel Spacing="5" Background="{DynamicResource ResourceKey=PaneBackground}">
            <StackPanel >
                <Button Content="Sample Button" />
            </StackPanel>
            <StackPanel Background="{DynamicResource ResourceKey=PrimaryBackground}"  Margin="10">
                <Button Content="Sample Button" />
            </StackPanel>
    </StackPanel>
        <!-- Add Controls for Previewer Here -->
    </Border>
  </Design.PreviewWith>
    <Style Selector="Button">
		<Setter Property="Foreground" Value="{DynamicResource ResourceKey=PrimaryText}"/>
        <Setter Property="Background" Value="{DynamicResource ResourceKey=PrimaryBackground}"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource ResourceKey=ButtonHoverForeground}"/>
        <Setter Property="Background" Value="{DynamicResource ResourceKey=ButtonHoverBackground}"/>
    </Style>
</Styles>
